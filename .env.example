# ================================================================
# MediCase AI Integration Module Configuration
# ================================================================

# Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# LLM Provider ('gemini' or 'mock')
LLM_PROVIDER=gemini

# Gemini Model name (e.g., gemini-2.5-flash, gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True

# CORS allowed origins (comma-separated or * for development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5000,http://localhost:8000,*
